@page "/meus-pedidos"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using ComunicacaoVisual.Client.Models
@inject ComunicacaoVisual.Client.Services.VendedorService VendedorService
@inject HttpClient Http
@inject IJSRuntime JS

<style>
    .page-container { background-color: #0f172a; min-height: 100vh; padding: 2rem; color: #f8fafc; }
    .header-section { margin-bottom: 2rem; }
    .custom-table { width: 100%; border-collapse: separate; border-spacing: 0 0.75rem; }
    .custom-table thead th { color: #94a3b8; text-transform: uppercase; font-size: 0.75rem; padding: 1rem; border: none; text-align: left; }
    .row-base { background-color: #1e293b; transition: all 0.2s; border-radius: 8px; }
    .row-base td { padding: 1rem; }
    
    .status-badge { padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 0.8rem; }
    .bg-arte { background: rgba(234, 179, 8, 0.2); color: #fde047; border: 1px solid #fde047; }
    .bg-pronto { background: rgba(34, 197, 94, 0.2); color: #bbf7d0; border: 1px solid #22c55e; }
    .bg-normal { background: #334155; color: #cbd5e1; }

    .btn-action { border-radius: 6px; padding: 0.4rem 0.8rem; font-weight: 600; font-size: 0.85rem; border: none; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; gap: 0.3rem;}
    .btn-green { background-color: #22c55e; color: white; }
    .btn-green:hover { background-color: #16a34a; }
    .btn-red { background-color: #ef4444; color: white; }
    .btn-red:hover { background-color: #dc2626; }
    .btn-yellow { background-color: #fedf00; color: #0f172a; }
    
    /* MODALS */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .modal-box { background: #1e293b; padding: 2rem; border-radius: 12px; width: 400px; border: 1px solid #475569; max-height: 90vh; overflow-y: auto; }
    .input-field { width: 100%; background: #0f172a; border: 1px solid #475569; color: white; padding: 0.6rem; border-radius: 6px; margin-bottom: 1rem; }
</style>

<div class="page-container">
    <div class="header-section">
        <h1 style="font-size: 1.8rem; font-weight: 800; color: #fedf00;">Meus Pedidos</h1>
        <p style="color: #94a3b8;">Gerencie a aprovação de artes e as entregas dos seus clientes.</p>
    </div>

    <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
        <input type="text" class="input-field" style="max-width: 400px; margin-bottom: 0;" 
               placeholder="Pesquisar por OS ou Nome do Cliente..." 
               @bind="termoPesquisa" @bind:event="oninput" @onkeyup="VerificarEnter" />
               
        <button class="btn-action btn-green" @onclick="PesquisarPedidos"><i class="oi oi-magnifying-glass"></i> Buscar</button>
        @if(!string.IsNullOrWhiteSpace(termoPesquisa)) { <button class="btn-action" style="background: #475569; color: white;" @onclick="LimparPesquisa">Limpar</button> }
    </div>

    @if (carregando) { <div style="color: #94a3b8;">Carregando seus pedidos...</div> }
    else if (pedidos == null || !pedidos.Any()) { <div style="color: #94a3b8; background: #1e293b; padding: 2rem; border-radius: 8px;">Nenhum pedido encontrado.</div> }
    else
    {
        <table class="custom-table">
            <thead>
                <tr><th>OS</th><th>Data</th><th>Cliente</th><th>Itens</th><th>Status Atual</th><th>Ações Necessárias</th></tr>
            </thead>
            <tbody>
                @foreach (var p in pedidos)
                {
                    <tr class="row-base">
                        <td style="font-weight: 800; color: white;">@p.Os</td>
                        <td style="color: #94a3b8;">@(p.DataPedido?.ToString("dd/MM HH:mm") ?? "-")</td>
                        <td style="font-weight: 600; color: white;">@p.Cliente</td>
                        <td style="color: #94a3b8;">@p.QtdItens material(is)</td>
                        <td><span class="status-badge @(p.StatusId == 2 || p.StatusId == 3 ? "bg-arte" : p.StatusId == 6 ? "bg-pronto" : "bg-normal")">@p.StatusAtual</span></td>
                        <td>
                            @if (p.StatusId == 2 || p.StatusId == 3)
                            {
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <button class="btn-action btn-green" @onclick="() => AtualizarStatus(p.PedidoId, 4)" title="Aprovar e Mandar pra Impressão">
                                        <i class="oi oi-check"></i> Aprovar
                                    </button>
                                    <button class="btn-action btn-yellow" @onclick="() => AbrirModalCorrecao(p.PedidoId, p.Os, p.ObservacaoGeral)" title="Alterar Medidas/Material">
                                        <i class="oi oi-pencil"></i> Corrigir
                                    </button>
                                    <button class="btn-action btn-red" @onclick="() => CancelarPedido(p.PedidoId, p.Os)" title="Cancelar OS">
                                        <i class="oi oi-x"></i> Cancelar
                                    </button>
                                </div>
                            }
                            else if (p.StatusId == 6)
                            {
                                <button class="btn-action btn-yellow" style="padding: 0.6rem 1.2rem; font-size: 1rem;" @onclick="() => AbrirModalEntrega(p.PedidoId, p.Os)">
                                    <i class="oi oi-box"></i> Realizar Entrega
                                </button>
                            }
                            else { <span style="color: #64748b; font-size: 0.85rem;">Aguardando produção...</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* 🛠️ NOVO MODAL DE CORREÇÃO: ALTERA TUDO! *@
@if (mostrarModalCorrecao)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 700px;">
            <h3 style="color: white; margin-top: 0; margin-bottom: 0.5rem;">Editar e Corrigir OS: @osSelecionada</h3>
            
            @if (carregandoDetalhes)
            {
                <p style="color: #fedf00;">Buscando os itens da OS no sistema...</p>
            }
            else if (pedidoDetalhado != null)
            {
                <div style="background: #0f172a; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                    <h4 style="color: #94a3b8; margin-top: 0; margin-bottom: 1rem;">Itens da OS</h4>
                    
                    @foreach(var item in pedidoDetalhado.Itens)
                    {
                        <div style="border: 1px solid #334155; padding: 1rem; border-radius: 6px; margin-bottom: 1rem;">
                            <label style="color: #94a3b8; font-size: 0.8rem;">Produto / Material</label>
                            <select class="input-field" @bind="item.TipoProdutoId">
                                @foreach(var tp in listaTiposProduto)
                                {
                                    <option value="@tp.Id">@tp.Nome</option>
                                }
                            </select>
                            
                            <div style="display: flex; gap: 1rem;">
                                <div style="flex: 1;">
                                    <label style="color: #94a3b8; font-size: 0.8rem;">Largura (m)</label>
                                    <input type="number" step="0.01" class="input-field" @bind="item.Largura" />
                                </div>
                                <div style="flex: 1;">
                                    <label style="color: #94a3b8; font-size: 0.8rem;">Altura (m)</label>
                                    <input type="number" step="0.01" class="input-field" @bind="item.Altura" />
                                </div>
                                <div style="flex: 1;">
                                    <label style="color: #94a3b8; font-size: 0.8rem;">Qtd</label>
                                    <input type="number" class="input-field" @bind="item.Quantidade" />
                                </div>
                            </div>

                            <label style="color: #94a3b8; font-size: 0.8rem;">Observação Técnica do Item (Ex: Fazer com acabamento X)</label>
                            <input type="text" class="input-field" @bind="item.ObservacaoTecnica" />
                        </div>
                    }
                </div>

                <label style="color: #94a3b8; font-size: 0.8rem;">Observação Geral (Para o Arte Finalista)</label>
                <textarea class="input-field" rows="3" @bind="textoCorrecao" placeholder="Descreva o que está errado na arte..."></textarea>
                
                <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                    <button class="btn-action" style="background: transparent; border: 1px solid #475569; color: white; flex: 1;" @onclick="FecharModais">Cancelar</button>
                    <button class="btn-action btn-yellow" style="flex: 2; justify-content: center;" @onclick="ConfirmarCorrecaoCompleta" disabled="@processando">
                        @(processando ? "Salvando..." : "Salvar Alterações e Corrigir")
                    </button>
                </div>
            }
        </div>
    </div>
}

@* 📦 MODAL DE ENTREGA FINANCEIRA *@
@if (mostrarModalEntrega)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h3 style="color: white; margin-top: 0; margin-bottom: 1.5rem;">Entregar OS: @osSelecionada</h3>
            <label style="color: #94a3b8; font-size: 0.8rem;">Valor Total Pago (R$)</label>
            <input type="number" step="0.01" class="input-field" @bind="valorPagamento" />
            <label style="color: #94a3b8; font-size: 0.8rem;">Forma de Pagamento</label>
            <select class="input-field" @bind="formaPagamento">
                <option value="Pix">Pix</option>
                <option value="Cartão de Crédito">Cartão de Crédito</option>
                <option value="Dinheiro">Dinheiro</option>
                <option value="Boleto">Boleto</option>
            </select>
            <label style="color: #94a3b8; font-size: 0.8rem;">Parcelas</label>
            <input type="number" min="1" class="input-field" @bind="parcelas" />
            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <button class="btn-action" style="background: transparent; border: 1px solid #475569; color: white; flex: 1;" @onclick="FecharModais">Cancelar</button>
                <button class="btn-action btn-green" style="flex: 2;" @onclick="ConfirmarEntrega" disabled="@processando">Confirmar Entrega</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MeuPedidoVendedorDTO>? pedidos;
    private bool carregando = true;
    private int usuarioIdLogado = 0;
    private bool processando = false;
    private string termoPesquisa = "";

    // Modais
    private bool mostrarModalEntrega = false;
    private bool mostrarModalCorrecao = false;
    private int pedidoIdSelecionado;
    private string osSelecionada = "";
    
    // Variáveis Correção Completa
    private bool carregandoDetalhes = false;
    private string textoCorrecao = "";
    private PedidoDetalhadoDto? pedidoDetalhado;
    private List<TipoProdutoOption> listaTiposProduto = new();

    // Variáveis Entrega
    private decimal valorPagamento = 0;
    private string formaPagamento = "Pix";
    private int parcelas = 1;

    protected override async Task OnInitializedAsync()
    {
        usuarioIdLogado = await GetUsuarioIdFromJwtAsync();
        try
        {
            // Carrega os Tipos de Produtos para o Dropdown do Modal
            listaTiposProduto = await Http.GetFromJsonAsync<List<TipoProdutoOption>>("api/Estoque/TiposProdutoListar") ?? new();
        } catch { }
        await CarregarPedidos();
    }

    private async Task PesquisarPedidos() => await CarregarPedidos();
    private async Task VerificarEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (e.Key == "Enter") await CarregarPedidos(); }
    private async Task LimparPesquisa() { termoPesquisa = ""; await CarregarPedidos(); }

    private async Task CarregarPedidos()
    {
        carregando = true;
        var todosMeusPedidos = await VendedorService.ObterMeusPedidosAsync(usuarioIdLogado, termoPesquisa);
        pedidos = todosMeusPedidos?.Where(p => p.StatusId < 7).ToList();
        carregando = false;
    }

    private void FecharModais() { mostrarModalEntrega = false; mostrarModalCorrecao = false; }

    // 🚀 APROVAR DIRETO (Sem esbarrar no financeiro)
    private async Task AtualizarStatus(int pedidoId, int novoStatusId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Deseja realmente APROVAR a arte e mandar para a impressão?")) return;

        // O segredo: Usamos o método genérico passando o NovoStatusId (4) e texto vazio!
        // Ele vai no banco e apenas avança a OS, ignorando o financeiro.
        var (sucesso, mensagem) = await VendedorService.SolicitarCorrecaoAsync(pedidoId, usuarioIdLogado, novoStatusId, "");
        
        if (sucesso) await CarregarPedidos(); 
        else await JS.InvokeVoidAsync("alert", mensagem);
    }

    private async Task CancelarPedido(int pedidoId, string os)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"ATENÇÃO! Deseja realmente CANCELAR a OS {os}? Ela será arquivada.")) return;
        var request = new CorrecaoCompletaInput { PedidoId = pedidoId, UsuarioId = usuarioIdLogado, NovaObservacao = "OS Cancelada", Itens = new() };
        var (sucesso, mensagem) = await VendedorService.SalvarCorrecaoCompletaAsync(request);
        if (sucesso) await CarregarPedidos();
    }

    private async Task AbrirModalCorrecao(int pedidoId, string os, string? obsAtual)
    {
        pedidoIdSelecionado = pedidoId;
        osSelecionada = os;
        textoCorrecao = obsAtual ?? "";
        mostrarModalCorrecao = true;
        carregandoDetalhes = true;
        
        try {
            pedidoDetalhado = await Http.GetFromJsonAsync<PedidoDetalhadoDto>($"api/Pedidos/PedidoDetalhado/{pedidoId}");
        } catch {
            await JS.InvokeVoidAsync("alert", "Erro ao carregar detalhes do pedido.");
        }
        carregandoDetalhes = false;
    }

    private async Task ConfirmarCorrecaoCompleta()
    {
        processando = true;
        var request = new CorrecaoCompletaInput
        {
            PedidoId = pedidoIdSelecionado,
            UsuarioId = usuarioIdLogado,
            NovaObservacao = textoCorrecao,
            Itens = pedidoDetalhado?.Itens ?? new List<ItemDetalhadoDto>()
        };

        var (sucesso, mensagem) = await VendedorService.SalvarCorrecaoCompletaAsync(request);
        processando = false;
        if (sucesso) { FecharModais(); await CarregarPedidos(); }
        else await JS.InvokeVoidAsync("alert", mensagem);
    }

    private void AbrirModalEntrega(int pedidoId, string os)
    {
        pedidoIdSelecionado = pedidoId; osSelecionada = os; valorPagamento = 0; formaPagamento = "Pix"; parcelas = 1;
        mostrarModalEntrega = true; 
    }
    
    private async Task ConfirmarEntrega()
    {
        if (valorPagamento <= 0) { await JS.InvokeVoidAsync("alert", "Informe um valor válido."); return; }
        processando = true;
        var request = new AtualizarStatusPedidoInput { PedidoId = pedidoIdSelecionado, NovoStatusId = 7, UsuarioId = usuarioIdLogado, ValorTotal = valorPagamento, FormaPagamento = formaPagamento, Parcelas = parcelas };
        var (sucesso, mensagem) = await VendedorService.AtualizarStatusPedidoAsync(request);
        processando = false;
        if (sucesso) { FecharModais(); await CarregarPedidos(); } else await JS.InvokeVoidAsync("alert", mensagem);
    }

    private async Task<int> GetUsuarioIdFromJwtAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrWhiteSpace(token)) return 0;
        try {
            var parts = token.Split('.');
            if (parts.Length != 3) return 0;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4) { case 2: payload += "=="; break; case 3: payload += "="; break; }
            var jsonBytes = Convert.FromBase64String(payload);
            using var doc = JsonDocument.Parse(jsonBytes);
            if (doc.RootElement.TryGetProperty("UsuarioId", out var idProp)) { if (int.TryParse(idProp.ToString(), out var id)) return id; }
            return 0;
        } catch { return 0; }
    }
}