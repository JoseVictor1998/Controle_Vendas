@page "/dashboard-gerencial"
@using System.Net.Http.Json
@using ComunicacaoVisual.Client.Models
@inject HttpClient Http

<style>
    .page-container { background-color: #0f172a; min-height: 100vh; padding: 2rem; color: #f8fafc; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .header-section { margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 1rem; }
    
    .section-title { color: #94a3b8; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 1rem; border-left: 4px solid #fedf00; padding-left: 10px; }

    /* CARDS FINANCEIROS (MAIORES) */
    .fin-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
    .card-fin { background: #1e293b; padding: 2rem; border-radius: 16px; border: 1px solid #334155; position: relative; overflow: hidden; }
    .card-fin h3 { color: #94a3b8; font-size: 1rem; margin-top: 0; }
    .card-fin .valor { font-size: 2.5rem; font-weight: 900; margin: 0.5rem 0; }
    
    /* Cores Financeiras */
    .txt-green { color: #22c55e; }
    .txt-red { color: #ef4444; }
    .txt-blue { color: #38bdf8; }
    .bg-glow-green { box-shadow: 0 0 20px rgba(34, 197, 94, 0.1); border-bottom: 4px solid #22c55e; }
    .bg-glow-red { box-shadow: 0 0 20px rgba(239, 68, 68, 0.1); border-bottom: 4px solid #ef4444; }
    .bg-glow-blue { box-shadow: 0 0 20px rgba(56, 189, 248, 0.1); border-bottom: 4px solid #38bdf8; }

    /* CARDS OPERACIONAIS */
    .op-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
    .card-op { background: #0f172a; padding: 1.5rem; border-radius: 12px; border: 1px solid #475569; text-align: center; }
    .card-op h4 { color: #cbd5e1; font-size: 0.9rem; margin-top: 0; }
    .card-op .numero { font-size: 2rem; font-weight: bold; color: #fedf00; }

    /* BADGES DE CRESCIMENTO */
    .badge-up { background: rgba(34, 197, 94, 0.2); color: #bbf7d0; padding: 4px 8px; border-radius: 6px; font-size: 0.8rem; font-weight: bold; }
    .badge-down { background: rgba(239, 68, 68, 0.2); color: #fca5a5; padding: 4px 8px; border-radius: 6px; font-size: 0.8rem; font-weight: bold; }
    .badge-neutral { background: rgba(100, 116, 139, 0.2); color: #e2e8f0; padding: 4px 8px; border-radius: 6px; font-size: 0.8rem; font-weight: bold; }

    .input-field { background: #1e293b; border: 1px solid #475569; color: white; padding: 0.6rem; border-radius: 6px; margin-right: 10px; }
    .btn-action { background-color: #fedf00; color: #0f172a; border-radius: 6px; padding: 0.6rem 1.5rem; font-weight: 800; cursor: pointer; border: none; }
</style>

<div class="page-container">
    <div class="header-section">
        <div>
            <h1 style="font-size: 2.2rem; font-weight: 900; color: white; margin: 0;">Dashboard <span style="color: #fedf00;">Gerencial</span></h1>
            <p style="color: #94a3b8; margin: 0;">Visão global de faturamento, custos e gargalos operacionais.</p>
        </div>
        <div>
            <select class="input-field" @bind="mesFiltro">
                @for (int i = 1; i <= 12; i++) { <option value="@i">Mês @i</option> }
            </select>
            <select class="input-field" @bind="anoFiltro">
                <option value="2025">2025</option><option value="2026">2026</option>
            </select>
            <button class="btn-action" @onclick="CarregarDados">Atualizar Visão</button>
        </div>
    </div>

    @if (carregando)
    {
        <div style="color: #fedf00; font-size: 1.2rem; text-align: center; margin-top: 5rem;">
            <i class="oi oi-loop-circular"></i> Analisando os cofres da empresa...
        </div>
    }
    else if (dadosMesAtual != null)
    {
        <h2 class="section-title">Financeiro (Ponto de Equilíbrio)</h2>
        <div class="fin-grid">
            <div class="card-fin bg-glow-green">
                <h3>Vendas Entregues (Entrada)</h3>
                <div class="valor txt-green">R$ @dadosMesAtual.Faturamento.ToString("N2")</div>
                <div>
                    @if (percFaturamento > 0) { <span class="badge-up">▲ +@percFaturamento.ToString("N1")%</span> }
                    else if (percFaturamento < 0) { <span class="badge-down">▼ @percFaturamento.ToString("N1")%</span> }
                    else { <span class="badge-neutral">- 0%</span> }
                    <span style="color: #64748b; font-size: 0.8rem; margin-left: 5px;">vs Mês Anterior</span>
                </div>
            </div>

            <div class="card-fin bg-glow-red">
                <h3>Custos Fixos / Variáveis (Saída)</h3>
                <div class="valor txt-red">R$ @dadosMesAtual.Custos.ToString("N2")</div>
                <div>
                    @* Para custos, se subiu é ruim (vermelho), se desceu é bom (verde) *@
                    @if (percCustos > 0) { <span class="badge-down">▲ Piorou +@percCustos.ToString("N1")%</span> }
                    else if (percCustos < 0) { <span class="badge-up">▼ Melhorou @percCustos.ToString("N1")%</span> }
                    else { <span class="badge-neutral">- 0%</span> }
                    <span style="color: #64748b; font-size: 0.8rem; margin-left: 5px;">vs Mês Anterior</span>
                </div>
            </div>

            <div class="card-fin bg-glow-blue">
                <h3>Lucro Líquido Estimado</h3>
                <div class="valor @(dadosMesAtual.Lucro >= 0 ? "txt-blue" : "txt-red")">
                    R$ @dadosMesAtual.Lucro.ToString("N2")
                </div>
                <div>
                    @if (dadosMesAtual.Lucro >= 0)
                    {
                        <span style="color: #38bdf8; font-size: 0.9rem; font-weight: bold;">✔️ Empresa no Azul</span>
                    }
                    else
                    {
                        <span style="color: #ef4444; font-size: 0.9rem; font-weight: bold;">⚠️ Atenção: Prejuízo</span>
                    }
                </div>
            </div>
        </div>

        <h2 class="section-title">Gargalos de Produção (Tempo Real)</h2>
        <div class="op-grid">
            <div class="card-op">
                <h4>🎨 Fila de Arte</h4>
                <div class="numero">@dadosMesAtual.QtdArte</div>
                <span style="color: #64748b; font-size: 0.8rem;">Aguardando Design</span>
            </div>
            <div class="card-op">
                <h4>🖨️ Fila de Impressão</h4>
                <div class="numero">@dadosMesAtual.QtdImpressao</div>
                <span style="color: #64748b; font-size: 0.8rem;">Na Plotter</span>
            </div>
            <div class="card-op">
                <h4>🔨 Fila de Produção</h4>
                <div class="numero">@dadosMesAtual.QtdProducao</div>
                <span style="color: #64748b; font-size: 0.8rem;">Montagem / Serralheria</span>
            </div>
            <div class="card-op">
                <h4>✅ Prontos / Acabamento</h4>
                <div class="numero" style="color: #22c55e;">@dadosMesAtual.QtdAcabamento</div>
                <span style="color: #64748b; font-size: 0.8rem;">Aguardando Entrega</span>
            </div>
        </div>
    }
</div>

@code {
    private bool carregando = true;
    private DashboardGerencialDTO? dadosMesAtual;
    private DashboardGerencialDTO? dadosMesAnterior;
    
    private int mesFiltro = DateTime.Now.Month;
    private int anoFiltro = DateTime.Now.Year;

    // Variáveis de Cálculo de Crescimento
    private decimal percFaturamento = 0;
    private decimal percCustos = 0;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        carregando = true;
        try
        {
            // 1. Busca os dados do mês selecionado
            dadosMesAtual = await Http.GetFromJsonAsync<DashboardGerencialDTO>($"api/Admin/DashboardGerencial?mes={mesFiltro}&ano={anoFiltro}");

            // 2. Calcula qual foi o mês passado
            int mesAnt = mesFiltro == 1 ? 12 : mesFiltro - 1;
            int anoAnt = mesFiltro == 1 ? anoFiltro - 1 : anoFiltro;

            // 3. Busca os dados do mês passado para comparar
            dadosMesAnterior = await Http.GetFromJsonAsync<DashboardGerencialDTO>($"api/Admin/DashboardGerencial?mes={mesAnt}&ano={anoAnt}");

            CalcularPorcentagens();
        }
        catch { /* Se der erro ignora e mostra os dados zerados */ }
        
        carregando = false;
    }

    private void CalcularPorcentagens()
    {
        if (dadosMesAtual != null && dadosMesAnterior != null)
        {
            // Evita divisão por zero
            if (dadosMesAnterior.Faturamento > 0)
                percFaturamento = ((dadosMesAtual.Faturamento - dadosMesAnterior.Faturamento) / dadosMesAnterior.Faturamento) * 100;
            else if (dadosMesAtual.Faturamento > 0)
                percFaturamento = 100; // Saiu do 0 para algo

            if (dadosMesAnterior.Custos > 0)
                percCustos = ((dadosMesAtual.Custos - dadosMesAnterior.Custos) / dadosMesAnterior.Custos) * 100;
            else if (dadosMesAtual.Custos > 0)
                percCustos = 100;
        }
    }
}