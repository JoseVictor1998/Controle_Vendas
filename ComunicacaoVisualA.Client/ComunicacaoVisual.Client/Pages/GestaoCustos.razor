@page "/gestao-custos"
@using System.Net.Http.Json
@using ComunicacaoVisual.Client.Models
@inject HttpClient Http
@inject IJSRuntime JS

<style>
    .page-container { background-color: #0f172a; min-height: 100vh; padding: 2rem; color: #f8fafc; }
    .header-section { margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; }
    
    .panel { background: #1e293b; padding: 1.5rem; border-radius: 12px; border: 1px solid #334155; margin-bottom: 2rem; }
    .input-field { background: #0f172a; border: 1px solid #475569; color: white; padding: 0.6rem; border-radius: 6px; width: 100%; margin-bottom: 1rem; }
    
    .btn-action { border-radius: 6px; padding: 0.6rem 1.2rem; font-weight: 600; cursor: pointer; border: none; }
    .btn-green { background-color: #22c55e; color: white; }
    .btn-red { background-color: #ef4444; color: white; }
    .btn-dark { background-color: #475569; color: white; }

    .custom-table { width: 100%; border-collapse: separate; border-spacing: 0 0.5rem; }
    .custom-table thead th { color: #94a3b8; text-transform: uppercase; font-size: 0.75rem; padding: 1rem; text-align: left; }
    .row-base { background-color: #1e293b; border-radius: 8px; }
    .row-base td { padding: 1rem; }
    
    .badge-pago { background: rgba(34, 197, 94, 0.2); color: #bbf7d0; padding: 4px 10px; border-radius: 6px; font-weight: bold; border: 1px solid #22c55e; }
    .badge-pendente { background: rgba(239, 68, 68, 0.2); color: #fca5a5; padding: 4px 10px; border-radius: 6px; font-weight: bold; border: 1px solid #ef4444; }
</style>

<div class="page-container">
    <div class="header-section">
        <div>
            <h1 style="font-size: 1.8rem; font-weight: 800; color: #fedf00; margin: 0;">Gestão de Custos</h1>
            <p style="color: #94a3b8; margin: 0;">Controle das despesas fixas e variáveis da empresa.</p>
        </div>
        <div style="display: flex; gap: 1rem; align-items: center;">
            <span style="color: #94a3b8; font-weight: bold;">Filtrar Mês:</span>
            <select class="input-field" style="margin: 0; width: auto;" @bind="mesFiltro">
                @for (int i = 1; i <= 12; i++) { <option value="@i">Mês @i</option> }
            </select>
            <select class="input-field" style="margin: 0; width: auto;" @bind="anoFiltro">
                <option value="2025">2025</option><option value="2026">2026</option>
            </select>
            <button class="btn-action btn-dark" @onclick="CarregarCustos">Atualizar</button>
        </div>
    </div>

    <div class="panel" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
        <div style="flex: 2; min-width: 200px;">
            <label style="color: #94a3b8; font-size: 0.8rem;">Descrição da Conta (Ex: Luz, Aluguel, Bobina)</label>
            <input type="text" class="input-field" style="margin: 0;" @bind="novoCusto.Descricao" placeholder="Nome da despesa..." />
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="color: #94a3b8; font-size: 0.8rem;">Valor (R$)</label>
            <input type="number" step="0.01" class="input-field" style="margin: 0;" @bind="novoCusto.Valor" />
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="color: #94a3b8; font-size: 0.8rem;">Data de Vencimento</label>
            <input type="date" class="input-field" style="margin: 0;" @bind="novoCusto.DataVencimento" />
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
            <input type="checkbox" @bind="novoCusto.StatusPagamento" id="chkPago" />
            <label for="chkPago" style="color: white; cursor: pointer;">Já está pago?</label>
        </div>
        <button class="btn-action btn-green" @onclick="SalvarCusto" disabled="@processando">
            <i class="oi oi-plus"></i> Adicionar Despesa
        </button>
    </div>

    <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; text-align: right;">
        <span style="color: #fca5a5; font-size: 1.2rem;">Total de Custos do Mês: </span>
        <span style="color: white; font-size: 1.5rem; font-weight: 800;">R$ @listaCustos.Sum(c => c.Valor).ToString("N2")</span>
    </div>

    @if (carregando)
    {
        <div style="color: #94a3b8;">Buscando as contas no cofre...</div>
    }
    else
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Vencimento</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th style="text-align: center;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!listaCustos.Any())
                {
                    <tr><td colspan="5" style="text-align: center; color: #94a3b8;">Nenhuma conta lançada neste mês. Ufa!</td></tr>
                }
                @foreach (var custo in listaCustos)
                {
                    <tr class="row-base">
                        <td style="color: white; font-weight: bold;">@custo.Descricao</td>
                        <td style="color: #94a3b8;">@custo.DataVencimento.ToString("dd/MM/yyyy")</td>
                        <td style="color: #ef4444; font-weight: bold;">R$ @custo.Valor.ToString("N2")</td>
                        <td>
                            @if (custo.StatusPagamento == true) { <span class="badge-pago">Pago</span> }
                            else { <span class="badge-pendente">Pendente</span> }
                        </td>
                        <td style="text-align: center;">
                            @if (custo.StatusPagamento == false)
                            {
                                <button class="btn-action btn-green" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; margin-right: 0.5rem;" @onclick="() => MudarStatus(custo.CustoId, true)">Baixar</button>
                            }
                            else
                            {
                                <button class="btn-action btn-dark" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; margin-right: 0.5rem;" @onclick="() => MudarStatus(custo.CustoId, false)">Desfazer</button>
                            }
                            <button class="btn-action btn-red" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;" @onclick="() => DeletarCusto(custo.CustoId)">X</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private bool carregando = true;
    private bool processando = false;
    private List<CustoFixoDTO> listaCustos = new();
    
    private int mesFiltro = DateTime.Now.Month;
    private int anoFiltro = DateTime.Now.Year;

    private CustoFixoInput novoCusto = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarCustos();
    }

    private async Task CarregarCustos()
    {
        carregando = true;
        try
        {
            listaCustos = await Http.GetFromJsonAsync<List<CustoFixoDTO>>($"api/Admin/Custos?mes={mesFiltro}&ano={anoFiltro}") ?? new();
        }
        catch { await JS.InvokeVoidAsync("alert", "Erro ao carregar custos do banco."); }
        carregando = false;
    }

    private async Task SalvarCusto()
    {
        if (string.IsNullOrWhiteSpace(novoCusto.Descricao) || novoCusto.Valor <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Preencha a descrição e um valor maior que zero.");
            return;
        }

        processando = true;
        var res = await Http.PostAsJsonAsync("api/Admin/CriarCusto", novoCusto);
        if (res.IsSuccessStatusCode)
        {
            // Limpa o formulário e recarrega a tabela
            novoCusto = new CustoFixoInput { DataVencimento = DateTime.Now }; 
            await CarregarCustos();
        }
        else { await JS.InvokeVoidAsync("alert", "Erro ao salvar a despesa."); }
        processando = false;
    }

    private async Task MudarStatus(int id, bool pago)
    {
        var res = await Http.PutAsJsonAsync($"api/Admin/AtualizarPagamentoCusto/{id}", pago);
        if (res.IsSuccessStatusCode) await CarregarCustos();
    }

    private async Task DeletarCusto(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja apagar essa conta?")) return;
        
        var res = await Http.DeleteAsync($"api/Admin/DeletarCusto/{id}");
        if (res.IsSuccessStatusCode) await CarregarCustos();
    }
}